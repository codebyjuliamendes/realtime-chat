# Copy to .env (never commit .env). All values are optional in development.

# development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=3003
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# SQLite file (sql.js). Use ":memory:" for a throwaway database.
DB_PATH=./data/chat.db
# How often pending writes are flushed to disk (ms).
PERSIST_INTERVAL_MS=1000

# REQUIRED in production: at least 32 random characters (openssl rand -hex 32).
# In development a secret is generated once and stored in data/.session-secret.
SESSION_SECRET=
SESSION_TTL_SECONDS=2592000

# Extra origins allowed to open WebSockets / call the API (comma separated).
# Empty = same origin only.
ALLOWED_ORIGINS=
# Set to true behind a reverse proxy / ingress so rate limits see the client IP.
TRUST_PROXY=false

# WebSocket limits
WS_MAX_PAYLOAD_BYTES=16384
WS_MAX_BUFFERED_BYTES=1048576
WS_AUTH_TIMEOUT_MS=5000
WS_HEARTBEAT_MS=30000
WS_RATE_LIMIT_BURST=20
WS_RATE_LIMIT_PER_SEC=5
WS_MAX_CHANNELS_PER_CONNECTION=50
MESSAGE_MAX_LENGTH=2000

# HTTP writes (session / channel creation) per IP per minute
HTTP_WRITE_RATE_LIMIT_PER_MIN=20
SHUTDOWN_TIMEOUT_MS=10000
