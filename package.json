{
  "name": "realtime-chat",
  "version": "2.0.0",
  "description": "Real-time chat over WebSockets (Node.js, Express, ws, SQLite via sql.js)",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i client/styles.css -o public/assets/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i client/styles.css -o public/assets/app.css --watch",
    "build": "npm run build:css",
    "prestart": "npm run build:css",
    "start": "node server/index.js",
    "dev": "npm run build:css && node --watch server/index.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "test:e2e": "node e2e/ui.e2e.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "pino": "^9.14.0",
    "sql.js": "^1.10.3",
    "swagger-ui-dist": "^5.34.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
